# dupe — J2-native exact duplicate finder MVP

# User modules are supported by verified J2 0.1.0 syntax:
#   import "module.j2"

import "scan.j2"
import "hash.j2"
import "group.j2"
import "output.j2"

func usage() = {
    print("dupe PATH [--json]")
    print("Find exact duplicate files and report reclaimable bytes.")
}

func find_root(args) = {
    if len(args) < 2 {
        give ""
    }
    give args[1]
}

func json_mode(args) = {
    for arg in args {
        if arg == "--json" {
            give true
        }
    }
    give false
}

args = proc.argv()
root = find_root(args)

if root == "" {
    usage()
} else {
    files = discover(root)
    candidates = size_candidates(files)
    hashed = hash_candidates(candidates)
    groups = group_duplicates(hashed)

    if json_mode(args) {
        emit_json(files, candidates, groups)
    } else {
        emit_human(files, candidates, groups)
    }
}
