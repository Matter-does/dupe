# T006-B Serial-Equivalent Native Baseline: Pure In-Memory Hashing
# Computes in-memory hashes with an explicit loop-carried dependency between
# iteration i and i-1, enforcing sequential evaluation.

args = proc.argv()
num_buffers := 100
buffer_size := 1024
if len(args) > 1 {
    num_buffers = json.parse(args[1])
}
if len(args) > 2 {
    buffer_size = json.parse(args[2])
}

# 1. Build a deterministic template string of approximately buffer_size bytes
block = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789=="
template := ""
repeat_count := buffer_size / 64
if repeat_count < 1 {
    repeat_count = 1
}

for _ in collect(1..repeat_count) {
    template = fmt("{}{}", template, block)
}

# Pre-allocate K distinct in-memory buffers in RAM
buffers := []
for i in collect(1..num_buffers) {
    buf = fmt("{}_{}", i, template)
    buffers = buffers + [buf]
}

# 2. Sequential hashing loop with loop-carried dependency
digests := []
prev_hash := "initial_seed"
for buf in buffers {
    # Loop-carried dependency: input is chained with previous hash digest
    chained = fmt("{}:{}", prev_hash, buf)
    d = hash.sha256(chained)
    prev_hash = d
    digests = digests + [d]
}

# 3. Deterministic summary output
combined := ""
for d in digests {
    combined = fmt("{}{}", combined, d)
}
print(hash.sha256(combined))
